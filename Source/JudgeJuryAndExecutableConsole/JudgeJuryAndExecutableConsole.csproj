<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472-windows</TargetFramework>
		<OutputType>Exe</OutputType>
		<UseWindowsForms>True</UseWindowsForms>
		<Platforms>x64</Platforms>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>JudgeJuryAndExecutableConsole</AssemblyName>
		<RootNamespace>$(AssemblyName)</RootNamespace>
		<AssemblyTitle>$(AssemblyName)</AssemblyTitle>
		<Title>$(AssemblyName)</Title>
		<Product>Judge-Jury-and-Executable</Product>
		<Authors>Adam White</Authors>
		<Company>Adam White</Company>
		<Copyright>Copyright © $([System.DateTime]::Now.Year.ToString())  Adam White</Copyright>
		<Description>A file system forensics analysis scanner and threat hunting tool. Scans file systems at the MFT  and OS level and stores data in SQL, SQLite or CSV. Threats and data can be probed harnessing the power and syntax of SQL.</Description>
		<RepositoryUrl>https://github.com/AdamWhiteHat/Judge-Jury-and-Executable</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup>
		<MajorVersion Condition=" '$(MajorVersion)' == '' ">1</MajorVersion>
		<MinorVersion Condition=" '$(MinorVersion)' == '' ">2</MinorVersion>
		<PatchVersion Condition=" '$(PatchVersion)' == '' ">0</PatchVersion>

		<BuildTimestamp>$([System.DateTime]::Now.DayOfYear.ToString().PadLeft(3,'0'))</BuildTimestamp>

		<Version>$(MajorVersion).$(MinorVersion).$(PatchVersion)</Version>
		<AssemblyVersion>$(Version).$(BuildTimestamp)</AssemblyVersion>
		<PackageVersion>$(AssemblyVersion)</PackageVersion>
	</PropertyGroup>

	<PropertyGroup />

	<PropertyGroup>
		<ApplicationIcon>Resources\JJE.ico</ApplicationIcon>
		<StartupObject>JudgeJuryAndExecutableConsole.Program</StartupObject>
		<GenerateDocumentationFile>False</GenerateDocumentationFile>
		<PackageProjectUrl>https://github.com/AdamWhiteHat/Judge-Jury-and-Executable</PackageProjectUrl>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\DataAccessLayers\CsvDataAccessLayer\CsvDataAccessLayer.csproj" />
		<ProjectReference Include="..\Core\DataAccessLayers\SqlDataAccessLayer\SqlDataAccessLayer.csproj" />
		<ProjectReference Include="..\Core\DataAccessLayers\SqliteDataAccessLayer\SqliteDataAccessLayer.csproj" />
		<ProjectReference Include="..\Core\FilePropertiesDataObject\FilePropertiesDataObject.csproj" />
		<ProjectReference Include="..\Core\FilePropertiesEnumerator\FilePropertiesEnumerator.csproj" />
		<ProjectReference Include="..\Core\Logging\Logging.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<Reference Include="System.Configuration" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<BaseOutputPath>..\..\Binaries\Console</BaseOutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<BaseOutputPath>..\..\Binaries\Console</BaseOutputPath>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<AppendPlatformToOutputPath>false</AppendPlatformToOutputPath>
	</PropertyGroup>

</Project>
