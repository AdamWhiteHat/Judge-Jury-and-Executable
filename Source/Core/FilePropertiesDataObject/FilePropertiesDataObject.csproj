<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472-windows</TargetFramework>
		<OutputType>Library</OutputType>
		<Platforms>x64</Platforms>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>FilePropertiesDataObject</AssemblyName>
		<RootNamespace>$(AssemblyName)</RootNamespace>
		<AssemblyTitle>$(AssemblyName)</AssemblyTitle>
		<Title>$(AssemblyName)</Title>
		<Product>Judge-Jury-and-Executable</Product>
		<Authors>Adam White</Authors>
		<Company>Adam White</Company>
		<Copyright>Copyright © $([System.DateTime]::Now.Year.ToString())  Adam White</Copyright>
		<Description>The FileProperties data class for Judge Jury and Executable</Description>
		<RepositoryUrl>https://github.com/AdamWhiteHat/Judge-Jury-and-Executable</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>..\..\..\..\README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup>
		<MajorVersion Condition=" '$(MajorVersion)' == '' ">1</MajorVersion>
		<MinorVersion Condition=" '$(MinorVersion)' == '' ">1</MinorVersion>
		<PatchVersion Condition=" '$(PatchVersion)' == '' ">0</PatchVersion>

		<BuildTimestamp>$([System.DateTime]::Now.DayOfYear.ToString().PadLeft(3,'0'))</BuildTimestamp>

		<Version>$(MajorVersion).$(MinorVersion).$(PatchVersion)</Version>
		<AssemblyVersion>$(Version).$(BuildTimestamp)</AssemblyVersion>
		<PackageVersion>$(AssemblyVersion)</PackageVersion>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\NtfsReader\NtfsReader.csproj" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Debug'">
		<Reference Include="YaraSharp">
			<HintPath>..\YaraSharp\Build\Debug\x64\YaraSharp.dll</HintPath>
		</Reference>
	</ItemGroup>
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<Reference Include="YaraSharp">
			<HintPath>..\YaraSharp\Build\Release\x64\YaraSharp.dll</HintPath>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="DeviceIOControlLib" Version="0.1.6" />
		<PackageReference Include="Microsoft.WindowsAPICodePack-Core" Version="1.1.0.2" />
		<PackageReference Include="Microsoft.WindowsAPICodePack-Shell" Version="1.1.0.0" />
		<PackageReference Include="PeNet" Version="1.6.1" />
		<PackageReference Include="PeNet.Asn1" Version="2.0.2" />
		<PackageReference Include="RawDiskLib" Version="0.2.1" />
		<PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.5" />
	</ItemGroup>

</Project>
