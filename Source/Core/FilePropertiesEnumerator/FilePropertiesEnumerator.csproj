<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net472-windows</TargetFramework>
		<OutputType>Library</OutputType>
		<Platforms>x64</Platforms>
	</PropertyGroup>

	<PropertyGroup>
		<AssemblyName>FilePropertiesEnumerator</AssemblyName>
		<RootNamespace>$(AssemblyName)</RootNamespace>
		<AssemblyTitle>$(AssemblyName)</AssemblyTitle>
		<Title>$(AssemblyName)</Title>
		<Product>Judge-Jury-and-Executable</Product>
		<Authors>Adam White</Authors>
		<Company>Adam White</Company>
		<Copyright>Copyright © $([System.DateTime]::Now.Year.ToString())  Adam White</Copyright>
		<Description>The library containing the logic for enumerating files for Judge Jury and Executable</Description>
		<RepositoryUrl>https://github.com/AdamWhiteHat/Judge-Jury-and-Executable</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageReadmeFile>..\..\..\..\README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup>
		<MajorVersion Condition=" '$(MajorVersion)' == '' ">1</MajorVersion>
		<MinorVersion Condition=" '$(MinorVersion)' == '' ">1</MinorVersion>
		<PatchVersion Condition=" '$(PatchVersion)' == '' ">0</PatchVersion>

		<BuildTimestamp>$([System.DateTime]::Now.DayOfYear.ToString().PadLeft(3,'0'))</BuildTimestamp>

		<Version>$(MajorVersion).$(MinorVersion).$(PatchVersion)</Version>
		<AssemblyVersion>$(Version).$(BuildTimestamp)</AssemblyVersion>
		<PackageVersion>$(AssemblyVersion)</PackageVersion>
	</PropertyGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\FilePropertiesDataObject\FilePropertiesDataObject.csproj" />
		<ProjectReference Include="..\NtfsReader\NtfsReader.csproj" />
	</ItemGroup>
	
	<ItemGroup>
		<Compile Update="Properties\Settings.Designer.cs">
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
			<AutoGen>True</AutoGen>
			<DependentUpon>Settings.settings</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<None Update="Properties\Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>
	
</Project>
