<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <runtime>
    <gcAllowVeryLargeObjects enabled="true" />
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="PeNet.Asn1" publicKeyToken="1e2e3568f0050bf5" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-2.0.2.0" newVersion="2.0.2.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
  <appSettings>
    <add key="Database.ConnectionString" value="SetMe" />
    <add key="FileEnumeration.DisableWorkerThread" value="false" />
  </appSettings>
  <system.diagnostics>
    <assert assertuienabled="false" logfilename="Debug-Assert.log" />
    <trace autoflush="true" indentsize="4" />
  </system.diagnostics>
</configuration>